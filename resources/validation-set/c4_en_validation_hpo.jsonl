062a \u0639\u0644\u0649 \u0646\u0633\u0628 \u0645\u062a\u0641\u0627\u0648\u062a\u0629 \u0645\u0646 \u062a \u0627 \u0631\u0643\u064a\u0632 \u0627\u0644\u0623\u0645\u0644\u0627\u062d \u0648\u0627\u0644\u0645\u0639\u0627\u062f\u0646 \u0627\u0644\u0645\u0630\u0627\u0628\u0629. \u0643\u0645\u0627 \u0623\u0646 \u0647\u0630\u0647 \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u0648\u0628\u0646\u0627\u0621 \u0639\u0644\u0649 \u0646\u0633\u0628 \u0627\u0644\u0623\u0645\u0644\u0627\u062d \u0627\u0644\u0630\u0627\u0626\u0628\u0629 \u0623\u0638\u0647\u0631\u062a \u0623\u0646\u0648\u0627\u0639 \u0645\u062e\u062a\u0644\u0641\u0629 \u0644\u0644\u0645\u064a\u0627\u0647 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0622\u0628\u0627\u0631 \u0643\u0627\u0646 \u0623\u063a\u0644\u0628\u0647\u0627 \u0645\u064a\u0627\u0647 \u0645\u062e\u062a\u0644\u0637\u0629 \u0644\u0639\u062f\u062f 10 \u0622\u0628\u0627\u0631 )\u0628\u064a\u0643\u0631\u0628\u0648\u0646\u0627\u062a \u0627\u0644\u0645\u0627\u063a\u0646\u064a\u0633\u064a\u0648\u0645( \u0646\u0627\u062a\u062c\u0629 \u0645\u0646 \u062a\u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u064a\u0627\u0647 \u0627\u0644\u0639\u0630\u0628\u0629 \u0627\u0644\u0642\u0627\u062f\u0645\u0629 \u0645\u0646 \u0634\u0645\u0627\u0644 \u0634\u0631\u0642 \u0627\u0644\u0632\u0631\u0648\u0628 \u0645\u0646 \u0623\u0648\u062f\u064a\u0629 \u0648\u0644\u0627\u064a\u0629 \u0645\u062d\u0636\u0629 \u0648\u0648\u0627\u062f\u064a \u0627\u0644\u062c\u0632\u064a \u0648\u0648\u0627\u062f\u064a \u062d\u0645\u062f \u0645\u0639 \u0627\u0644\u0645\u064a\u0627\u0647 \u0627\u0644\u0645\u0627\u0644\u062d\u0629 \u0641\u064a \u0627\u0644\u062e \u0627 \u0632\u0646 \u0627\u0644\u062c\u0648\u0641\u064a \u0627\u0644\u0639\u0645\u064a\u0642\u060c \u0645\u0639 \u0648\u062c\u0648\u062f \u0645\u064a\u0627\u0647 \u0645\u0627\u0644\u062d\u0629 )\u0643\u0644\u0648\u0631\u064a\u062f \u0627\u0644\u0635\u0648\u062f\u064a \u0648\u0645( \u0644\u0639\u062f\u062f 4 \u0622\u0628\u0627\u0631 \u0648 6 \u0622\u0628\u0627\u0631 \u0642\u0644\u064a\u0644\u0629 \u0627\u0644\u0645\u0644\u0648\u062d\u0629 )\u0643\u0644\u0648\u0631\u064a\u062f \u0627\u0644\u0645\u0627\u063a\u0646\u064a\u0633\u064a\u0648\u0645(. \u0643\u0645\u0627 \u0623\u0638\u0647\u0631\u062a \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u0623\u0646 \u0627\u0644\u0623\u064a\u0648\u0646\u0627\u062a \u0627\u0644\u0633\u0627\u0626\u062f\u0629 \u0641\u064a \u0645\u064a\u0627\u0647 \u0627\u0644\u0622\u0628\u0627\u0631 \u062a\u062a\u062e\u0630 \u0627\u0644\u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u062a\u0627\u0644\u064a : )\u0635\u0648\u062f\u064a\u0648\u0645 < \u0645\u0627\u063a\u0646\u064a\u0633\u064a \u0648\u0645 < \u0643\u0627\u0644\u0633\u064a\u0648\u0645 < \u0628\u0648\u062a\u0627\u0633\u064a\u0648\u0645( \u0648\u0627\u0644\u0623\u064a\u0648\u0646\u0627\u062a \u0627\u0644\u0633\u0627\u0644\u0628\u0629 \u062a\u062a\u062e\u0630 \u0627\u0644\u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u062a\u0627\u0644\u064a: )\u0643\u0644\u0648\u0631 < \u0628\u064a\u0643\u0631\u0628\u0648\u0646\u0627\u062a < \u0643\u0628\u0631\u064a\u062a\u0627\u062a < \u0646\u064a\u062a \u0627 \u0631\u062a(. \u0648 \u0628\u0646\u0627\u0621 \u0639\u0644\u0649 \u062d\u0633\u0627\u0628 \u0645\u0639\u0627\u0645\u0644 \u0627\u0645\u062a\u0635\u0627\u0635 \u0627\u0644\u0635\u0648\u062f\u064a\u0648\u0645 ) (SAR) \u062a\u0628\u064a\u0646 \u0623\u0646 65 % \u0645\u0646 \u0627\u0644\u0622\u0628\u0627\u0631 \u064a\u0642\u0639 \u0636\u0645\u0646 \u0641\u0626\u0629 \u0627\u0644\u0645\u064a\u0627\u0647 \u0630\u0627\u062a \u0627\u0644\u062e\u0637\u0648\u0631\u0629 \u0627\u0644\u0623\u0642\u0644 \u0644\u0623\u064a\u0648\u0646 \u0627\u0644\u0635\u0648\u062f\u064a\u0648\u0645 \u0648\u0627\u0644\u0645\u062a\u0648\u0633\u0637\u0629 \u0644\u0645\u0639\u062f\u0644 \u0627\u0644\u0645\u0644\u0648\u062d\u0629 \u0644\u0630\u0644\u0643 \u0641\u0647\u064a \u0622\u0645\u0646\u0629 \u0644\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0632 \u0627 \u0631\u0639\u064a \u0628\u0627\u0633\u062a\u062b\u0646\u0627\u0621 \u0628\u0626\u0631 \u0648\u0627\u062d\u062f \u064a\u0642\u0639 \u0641\u064a \u0641\u0626\u0629 \u0627\u0644\u0645\u0644\u0648\u062d\u0629 \u0627\u0644\u0639\u0627\u0644\u064a\u0629. \u0623\u0645\u0627 \u0645\u0646 \u062d\u064a\u062b \u0627\u0644\u062a\u062d\u0627\u0644\u064a\u0644 \u0627\u0644\u0645\u064a\u0643\u0631\u0648\u0628\u064a\u0629 \u0648\u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0645\u0642\u064a\u0627\u0633 \u0645\u0646\u0638\u0645\u0629 \u0627\u0644\u0635\u062d\u0629 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0629 \u0641\u0642\u062f \u0623\u0638\u0647\u0631\u062a \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u0627\u062d\u062a\u0648\u0627\u0621 \u0627\u0644\u0645\u064a\u0627\u0647 \u0639\u0644\u0649 \u0646\u0633\u0628 \u0639\u0627\u0644\u064a\u0629 \u0645\u0646 \u0628\u0643\u062a\u064a\u0631\u064a\u0627 \u0627\u0644\u0643\u0648\u0644\u064a\u0641\u0648\u0631\u0645 ix \u0648\u0638\u0647\u0648\u0631 \u0628\u0643\u062a\u064a\u0631\u064a\u0627 \u0627\u0644\u0625\u064a\u0643\u0648\u0644\u0627\u064a ) )Coliform( E. coli ( \u0641\u064a \u062a\u0633\u0639 \u0639\u064a\u0646\u0627\u062a. \u0648 \u0628\u0630\u0644\u0643\u060c \u0641\u0625\u0646 \u062c\u0645\u064a\u0639 \u0627\u0644\u0622\u0628\u0627\u0631 ) 100 )% \u0644\u0627 \u062a\u0635\u0644\u062d \u0644\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0628\u0634\u0631\u064a \u0643\u0645\u064a\u0627\u0647 \u0634\u0631\u0628 \u0645\u0628\u0627\u0634\u0631\u0629 \u0628\u062f\u0648\u0646 \u0645\u0639\u0627\u0644\u062c\u0629\u060c \u0643\u0645\u0627 \u0623\u0646 \u0646\u0633\u0628\u0629 70 % \u0645\u0646\u0647\u0627 \u0644\u0627 \u062a\u0635\u0644\u062d \u0644\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062d\u064a\u0648\u0627\u0646\u064a \u0648\u0644\u0643\u0646\u0647\u0627 \u0645\u0646 \u062c\u0627\u0646\u0628 \u0622\u062e\u0631 \u062a\u0635\u0644\u062d \u062c\u0645\u064a\u0639\u0647\u0627 \u0644\u0644\u0627\u0633\u062a\u062e\u062f\u